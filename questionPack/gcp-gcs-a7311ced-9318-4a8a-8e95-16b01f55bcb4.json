[{"questionText":"What is the maximum size of an object that can be stored in Google Cloud Storage?","type":"","category":"gcp","subcategory":"gcs","dateadded":"3-January-2025","certification":"","answerReference":"https://cloud.google.com/storage/docs/quotas#objects","answers":[{"text":"5 TB","iscorrect":true},{"text":"5 PB","iscorrect":false},{"text":"5 GB","iscorrect":false}]},{"questionText":"What is the maximum number of buckets you can create per project in Google Cloud Storage by default?","type":"","category":"gcp","subcategory":"gcs","dateadded":"3-January-2025","certification":"","answerReference":"https://cloud.google.com/storage/docs/creating-buckets#requirements","answers":[{"text":"100","iscorrect":false},{"text":"250","iscorrect":false},{"text":"1,000","iscorrect":true}]},{"questionText":"Which of the following storage classes in Google Cloud Storage offers the lowest cost for storing data that is accessed less frequently?","type":"","category":"gcp","subcategory":"gcs","dateadded":"3-January-2025","certification":"","answerReference":"https://cloud.google.com/storage/docs/storage-classes","answers":[{"text":"Nearline","iscorrect":false},{"text":"Archive","iscorrect":true},{"text":"Coldline","iscorrect":false}]},{"questionText":"Which command-line tool is used to interact with Google Cloud Storage?","type":"","category":"gcp","subcategory":"gcs","dateadded":"3-January-2025","certification":"","answerReference":"https://cloud.google.com/storage/docs/gsutil","answers":[{"text":"gsutil","iscorrect":true},{"text":"gcloud storage","iscorrect":false},{"text":"kubectl","iscorrect":false}]},{"questionText":"What feature of Google Cloud Storage allows you to store data across multiple geographic locations for redundancy?","type":"","category":"gcp","subcategory":"gcs","dateadded":"3-January-2025","certification":"","answerReference":"https://cloud.google.com/storage/docs/dual-regions","answers":[{"text":"Object Versioning","iscorrect":false},{"text":"Cross-Region Replication","iscorrect":false},{"text":"Dual-Region Buckets","iscorrect":true}]},{"questionText":"Which Google Cloud Storage consistency model ensures that all reads after a write return the latest data?","type":"","category":"gcp","subcategory":"gcs","dateadded":"3-January-2025","certification":"","answerReference":"https://cloud.google.com/storage/docs/consistency","answers":[{"text":"Eventual Consistency","iscorrect":false},{"text":"Strong Consistency","iscorrect":true},{"text":"Read-After-Write Consistency","iscorrect":false}]},{"questionText":"What is the name of the JSON API used for accessing Google Cloud Storage?","type":"","category":"gcp","subcategory":"gcs","dateadded":"3-January-2025","certification":"","answerReference":"https://cloud.google.com/storage/docs/json_api/","answers":[{"text":"Cloud Storage XML API","iscorrect":false},{"text":"Cloud Storage Transfer API","iscorrect":false},{"text":"Cloud Storage JSON API","iscorrect":true}]},{"questionText":"What is the feature provided by Google Cloud Storage that automatically moves objects between different storage classes based on predefined rules?","type":"","category":"gcp","subcategory":"gcs","dateadded":"3-January-2025","certification":"","answerReference":"https://cloud.google.com/storage/docs/lifecycle","answers":[{"text":"Bucket Lock","iscorrect":false},{"text":"Lifecycle Management","iscorrect":true},{"text":"Object Hold","iscorrect":false}]},{"questionText":"How can you control access to objects stored in a Google Cloud Storage bucket?","type":"","category":"gcp","subcategory":"gcs","dateadded":"3-January-2025","certification":"","answerReference":"https://cloud.google.com/storage/docs/access-control","answers":[{"text":"Using Access Control Lists (ACLs)","iscorrect":true},{"text":"Using Firewall rules","iscorrect":false},{"text":"Using Virtual Private Cloud (VPC)","iscorrect":false}]},{"questionText":"What is the feature in Google Cloud Storage that allows you to manage metadata tags assoc