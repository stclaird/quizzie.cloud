# Question Creator Environment Configuration
PORT=:5001
QUESTIONSDIR=./questions
GEMINIMODEL=gemini-1.5-flash
LOGLEVEL=info
ENVIRONMENT=development

# Available environments:
# development - Human-readable console logs (default)
# production - Structured JSON logs

# Available log levels:
# debug - Most verbose, includes debug messages
# info - Default level, general information (recommended)
# warn - Warning messages and above
# error - Error messages only
# fatal - Fatal errors only
